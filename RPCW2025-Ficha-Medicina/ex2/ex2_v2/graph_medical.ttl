        :Rest .

:Ontology a owl:Ontology .

:Patient1 a :Patient ;
    :exhibitsSymptom :Cough,
        :Fever,
        :SoreThroat ;
    :name "Paul Harrods" .

:Patient2 a :Patient ;
    :exhibitsSymptom :Fatigue,
        :FrequentUrination,
        :IncreasedThirst ;
    :name "Ana Montana" .

:exhibitsSymptom a owl:ObjectProperty ;
    rdfs:domain :Patient ;
    rdfs:range :Symptom .

:hasDisease a owl:ObjectProperty ;
    rdfs:domain :Patient ;
    rdfs:range :Disease .

:hasSymptom a owl:ObjectProperty ;
    rdfs:domain :Disease ;
    rdfs:range :Symptom .

:hasTreatment a owl:ObjectProperty ;
    rdfs:domain :Disease ;
    rdfs:range :Treatment .

:receivesTreatment a owl:ObjectProperty ;
    rdfs:domain :Patient ;
    rdfs:range :Treatment .

