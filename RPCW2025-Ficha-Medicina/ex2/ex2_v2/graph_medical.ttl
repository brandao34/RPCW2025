ns1:AIDS a ns1:Disease ;
    ns1:hasSymptom ns1:extra_marital_contacts,
        ns1:high_fever,
        ns1:muscle_wasting,
        ns1:patches_in_throat .

ns1:Acne a ns1:Disease ;
    ns1:hasSymptom ns1:blackheads,
        ns1:pus_filled_pimples,
        ns1:scurring,
        ns1:skin_rash .

ns1:Alcoholic_hepatitis a ns1:Disease ;
    ns1:hasSymptom ns1:abdominal_pain,
