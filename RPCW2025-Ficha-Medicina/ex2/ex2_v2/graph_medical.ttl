        ns1:fluid_overload,
        ns1:history_of_alcohol_consumption,
        ns1:swelling_of_stomach,
        ns1:vomiting,
        ns1:yellowish_skin .

ns1:Allergy a ns1:Disease ;
    ns1:hasSymptom ns1:chills,
        ns1:continuous_sneezing,
        ns1:shivering,
        ns1:watering_from_eyes .

ns1:Arthritis a ns1:Disease ;
